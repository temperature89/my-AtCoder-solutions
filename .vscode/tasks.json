{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "C++ Build and Run (AtCoder)",
      "command": "bash",
      "args": [
        "-c",
        "output=\"$1\"; workspace=\"$3\"; g++ -std=c++20 -O2 -Wall -Wextra -g -I \"$workspace\" \"$2\" -o \"$output\" && \"$output\"",
        "bash",
        "${fileDirname}/${fileBasenameNoExtension}",
        "${file}",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}